SECTORS_API_KEY=your_key_here
# Telegram bot (create with @BotFather). TELEGRAM_CHAT_ID is optional: an extra chat that always gets the digest.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Free-form questions in the bot: a language-model CLI that reads the prompt on stdin (leave empty to disable).
ARUS_ASK_CMD=
# Secret Telegram sends with every webhook call (any random string; set the same value on Vercel)
TELEGRAM_WEBHOOK_SECRET=
# Bot storage on Vercel: added automatically by the Upstash for Redis integration
KV_REST_API_URL=
KV_REST_API_TOKEN=
